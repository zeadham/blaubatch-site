0% {\n    opacity: 0.5;\n    transform: translateY(-10px);\n  }\n\n  100% {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.summaryRowExpanded {\n  align-items: flex-start;\n  border-bottom: var(--spectrum-gray-200) solid var(--spectrum-alias-border-size-thin);\n  display: flex;\n  flex-direction: column;\n  height: auto;\n  margin-top: 8px;\n  overflow: hidden;\n  position: relative;\n}\n\n.summaryTextExpanded {\n  box-sizing: border-box;\n  flex-shrink: 0;\n  height: auto;\n  overflow-y: auto;\n  padding-right: 8px;\n  text-overflow: unset;\n  white-space: normal;\n  width: auto;\n}\n\n.actionButton {\n  align-items: center;\n  background: none;\n  border: none;\n  cursor: pointer;\n  display: flex;\n  justify-content: center;\n  padding: 3px;\n}\n\n.actionButton:hover {\n  background-color: var(--spectrum-gray-200);\n}\n\n.aiAssistantButton {\n  align-items: center;\n  background: none;\n  border: 2px solid var(--spectrum-gray-300);\n  border-radius: 12px;\n  color: var(--spectrum-gray-800);\n  cursor: pointer;\n  display: flex;\n  font-family: "Adobe Clean", sans-serif;\n  font-size: 12px;\n  font-weight: 700;\n  line-height: 1;\n  margin-left: auto;\n  min-height: 24px !important;\n  padding: 4px 8px;\n  width: auto;\n}\n\n/* Footer typography overrides for this expanded card instance */\n.footerOverride [data-testid="ai-card-template-footer"] {\n  color: var(--spectrum-global-color-gray-600);\n  font-size: 12px;\n  font-weight: 400;\n  line-height: 18px;\n  margin-top: 7px;\n}\n\n.footerOverride [data-testid="ai-card-template-footer"] a {\n  color: var(--spectrum-global-color-gray-600);\n  font-size: 12px;\n  font-weight: 400;\n  line-height: 18px;\n}\n\n.likeActiveIcon svg {\n  --iconFill: var(--spectrum-blue-700);\n\n  margin: 0 7px;\n}\n\n.dislikeActiveIcon svg {\n  --iconFill: var(--spectrum-red-800);\n\n  margin: 0 7px;\n}\n\n.positionRelative {\n  position: relative;\n}\n\n.genaiAutoSummaryContainerExpandedAnimation {\n  animation: containerExpand 0.3s ease-out forwards;\n}\n\n@keyframes containerExpand {\n  0% {\n    max-height: 80px;\n  }\n\n  25% {\n    max-height: 120px;\n  }\n\n  50% {\n    opacity: 180px;\n  }\n\n  75% {\n    max-height: 240px;\n  }\n\n  100% {\n    max-height: 400px;\n  }\n}\n\n.genaiAutoSummaryContainerCollapsedAnimation {\n  animation: containerCollapse 0.3s ease-in forwards;\n}\n\n@keyframes containerCollapse {\n  0% {\n    max-height: 400px;\n  }\n\n  25% {\n    max-height: 240px;\n  }\n\n  50% {\n    max-height: 180px;\n  }\n\n  75% {\n    max-height: 120px;\n  }\n\n  100% {\n    max-height: 80px;\n  }\n}\n\n.scrollArrowButton {\n  align-items: center;\n  background: linear-gradient(90deg, transparent 0%, var(--spectrum-gray-50) 100%);\n  cursor: pointer;\n  display: flex;\n  justify-content: flex-end;\n  opacity: 1;\n  padding: 7px 0;\n  pointer-events: auto;\n  position: absolute;\n  right: 0;\n  top: 0;\n  transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  width: 112px;\n  z-index: 10;\n}\n\n.scrollArrowButtonDark {\n  background: linear-gradient(90deg, transparent 0%, var(--spectrum-gray-200) 100%);\n}\n\n.leftScrollArrowButton {\n  align-items: center;\n  background: linear-gradient(270deg, transparent 0%, var(--spectrum-gray-50) 100%);\n  cursor: pointer;\n  display: flex;\n  justify-content: flex-start;\n  left: 8px;\n  opacity: 0;\n  padding: 7px 0;\n  pointer-events: none;\n  position: absolute;\n  top: 0;\n  transition: opacity 0.2s cubic-bezier(0.4, 0, 0.2, 1);\n  width: 112px;\n  z-index: 10;\n}\n\n.leftScrollArrowButtonDark {\n  background: linear-gradient(270deg, transparent 0%, var(--spectrum-gray-200) 100%);\n}\n'],sourceRoot:""}]),i.locals={cardExpanded:"GenAIAutoSummaryCardExpanded__cardExpanded___g3r2I",cardExpandedWithAnimation:"GenAIAutoSummaryCardExpanded__cardExpandedWithAnimation___UYrDP",expandCardIn:"GenAIAutoSummaryCardExpanded__expandCardIn___gFluT",summaryRowExpanded:"GenAIAutoSummaryCardExpanded__summaryRowExpanded___nKxHW",summaryTextExp