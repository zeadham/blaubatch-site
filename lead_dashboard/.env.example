# Copy this file to .env and fill in your values. Never commit .env.

# Gemini key for writing connection notes (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Gemini model used to write connection notes
GEMINI_MODEL=gemini-2.5-flash

# Seconds to wait between leads during dispatch (keeps the account safe).
# Schedule, per-run limits, webhook and email settings are in the dashboard's
# Settings window instead.
DISPATCH_DELAY_SECONDS=20

# How many inbox conversations the sync task reads (newest first)
SYNC_MAX_CONVERSATIONS=30

# Show the browser window (recommended: LinkedIn login and 2FA need it)
HEADLESS=false

# Password for the SMTP account used by the email fallback (Settings > Email).
# For Gmail/Google Workspace, use an App Password, not your normal password.
SMTP_PASSWORD=

# Optional: signs every webhook request with an X-Signature-SHA256 header
# (hex HMAC-SHA256 of the body) so the receiver can verify it.
WEBHOOK_SECRET=
