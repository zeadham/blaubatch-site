on: absolute;\n  width: 47px;\n}\n\n.fileLoader {\n  align-items: center;\n  background: var(--dc-global-color-background);\n  height: 60px;\n  justify-content: center;\n  width: 47px;\n}\n\n.fileNameWrapper {\n  align-items: center;\n  max-width: 222px;\n}\n\n.fileInfoWrapper {\n  flex-direction: column;\n  flex-grow: 1;\n  justify-content: center;\n  margin-left: 8px;\n}\n\n.fileName {\n  -webkit-box-orient: vertical;\n  color: var(--spectrum-global-color-gray-800) !important;\n  display: block;\n  font-size: 16px !important;\n  -webkit-line-clamp: 1;\n  line-height: 18px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.sourcesItem {\n  border-radius: 8px;\n  display: flex;\n  padding: 8px;\n}\n\n.sourcesItemSelected {\n  background: var(--spectrum-gray-200);\n  border-radius: 8px;\n  display: flex;\n  padding: 8px;\n}\n\n.sourcesItem:hover {\n  background: var(--spectrum-gray-100);\n}\n\n.forwardSlash {\n  font-size: 11px;\n  margin-left: 2px;\n  margin-right: 2px;\n}\n\n.breadcrumbLink {\n  cursor: pointer;\n  text-decoration: underline;\n}\n\n.commonBreadCrumb {\n  -webkit-box-orient: vertical;\n  color: var(--spectrum-gray-800);\n  display: -webkit-box;\n  font-size: 12px;\n  -webkit-line-clamp: 1;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.disablePointerEvents {\n  pointer-events: none;\n}\n\n.dialog > div {\n  display: block !important;\n}\n\n.sourcesPanelItemWrapper {\n  max-height: 288px;\n  overflow-y: auto;\n  scrollbar-width: auto;\n}\n\n.sourcesPanelItemWrapper [role="gridcell"] {\n  border-radius: 8px !important;\n  padding: 0 !important;\n}\n\n.sourcesPanelItemWrapper * [role="gridcell"] {\n  border-radius: 8px !important;\n  padding: 0 !important;\n}\n\n.sourcesPanelItemWrapper [role="gridcell"] > div {\n  display: block !important;\n}\n\n.onlyBackground {\n  align-items: center;\n  border-radius: 4px;\n  display: flex;\n  height: 60px;\n  justify-content: center;\n  width: 47px;\n}\n\n:global(.spectrum--dark) .onlyBackground pa